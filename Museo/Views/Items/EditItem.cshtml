@model Museo.ViewModels.EditItemVeiwModel

<h1>Edit Item</h1>

<form asp-action="EditItem" method="post">

    <div>
        <label asp-for="Preview_Image"></label>
        <input asp-for="Preview_Image" />
        <span asp-validation-for="Preview_Image"></span>
    </div>

    <div>
        <label asp-for="Note"></label>
        <textarea asp-for="Note"></textarea>
        <span asp-validation-for="Note"></span>
    </div>

    <button type="submit">Save Changes</button>

</form>

<a asp-action="Item">Back</a>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}