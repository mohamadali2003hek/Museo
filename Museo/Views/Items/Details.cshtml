@model Museo.ViewModels.ItemDetailsViewModel

@{
    ViewData["Title"] = Model.Title;
}

<div class="container mt-4">

    ```
    <!-- Item Details -->
    <div class="card mb-4">
        <div class="card-body">

            <h1 class="card-title">@Model.Title</h1>

            <p class="text-muted">
                @Model.Created_at
            </p>

            <p>
                @Model.Note
            </p>

            @if (!string.IsNullOrEmpty(Model.Url))
            {
                <a href="@Model.Url"
                       target="_blank"
                       class="btn btn-primary">
                    Open Post
                </a>
            }

            <p class="mt-3">
                Source: <strong>@Model.Source</strong>
            </p>

        </div>
    </div>


    <!-- Likes -->
    <form asp-controller="Items"
          asp-action="Like"
          asp-route-id="@Model.Id"
          method="post">

        <button type="submit">
            ❤️ @Model.Likes.Count Likes
        </button>

    </form>


    <!-- Comments -->
    <div class="card">

        <div class="card-body">

            <h3>Comments</h3>

            @if (Model.Comments != null && Model.Comments.Any())
            {
                foreach (var comment in Model.Comments)
                {
                    <div class="border rounded p-3 mb-3">

                        <strong>
                            @comment.User?.UserName
                        </strong>

                        <p class="mb-0">
                            @comment.Content
                        </p>

                    </div>
                }
            }
            else
            {
                <p class="text-muted">
                    No comments yet.
                </p>
            }

        </div>

    </div>
    ```

</div>
