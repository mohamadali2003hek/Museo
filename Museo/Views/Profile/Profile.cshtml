@model Museo.ViewModels.ProfileViewModel

@{
    ViewData["Title"] = "My Profile";
}

<h1>My Profile</h1>

<div>
    <p>
        <strong>Username:</strong>
        @Model.Username
    </p>

    ```
    <p>
        <strong>Email:</strong>
        @Model.Email
    </p>

    <p>
        <strong>Bio:</strong>
        @Model.Bio
    </p>

    <p>
        <strong>Created At:</strong>
        @Model.CreatedAt
    </p>
    ```

</div>

<a asp-controller="Home" asp-action="Index">
    Back to Home
</a>

<form asp-controller="Profile"
      asp-action="DeleteAccount"
      method="post"
      onsubmit="return confirm('Are you sure you want to delete your account?');">

    <button type="submit">
        Delete Account
    </button>

</form>
